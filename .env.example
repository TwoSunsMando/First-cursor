# Robinhood Chain RPC (Alchemy WSS recommended for production scanning)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
WSS_RPC_URL=

# paper | live  (default: paper)
EXECUTION_MODE=paper

# Learning Mode (paper only): mine closed trades → score bonuses/penalties
LEARNING_MODE=true
LEARN_MIN_SAMPLES=5
LEARN_INTERVAL_MS=300000

# DexPaprika trending / recent boost poller (no API key)
TRENDING_ENABLED=true
TRENDING_INTERVAL_MS=120000
TRENDING_COOLDOWN_MS=900000
TRENDING_LIMIT=15
TRENDING_MIN_VOLUME_USD_24H=25000
TRENDING_MIN_LIQUIDITY_USD=5000
TRENDING_MIN_TXNS_24H=50
# Trending should spice entries, not monopolize them
TRENDING_MOMENTUM_SCALE=0.55
MAX_TRENDING_OPEN_POSITIONS=3

# Overnight edge: prefer mid-liq; skip mega-liq trending majors
PREFERRED_LIQ_MIN_ETH=5
PREFERRED_LIQ_MAX_ETH=50
SKIP_TRENDING_LIQ_ETH=50
# Late-entry blow-off (15m vol / buys) — hard skip on trending/boost
LATE_ENTRY_VOL_ETH_15M=12
LATE_ENTRY_BUYS=45
# BUY needs boost/new-pool, mid-liq, or moderate momentum — not raw score alone
BUY_REQUIRE_CONFIRMING_EDGE=true

# Re-entry bans after stop-loss / hard loss / dead-chop (token + ticker)
REENTRY_AFTER_STOP_MS=21600000
REENTRY_AFTER_HARD_LOSS_MS=86400000
REENTRY_STOP_STREAK=2
CHOP_FLAT_PNL_PCT=5
CHOP_STREAK=2
REENTRY_AFTER_CHOP_MS=172800000

# Moon / runner book — still enter at launch (scout); upgrade in-position
# to scale-out + trail instead of full +65% exit
MOON_ENABLED=true
MAX_MOON_POSITIONS=2
MOON_ARM_PNL_PCT=35
MOON_ARM_STRONG_PNL_PCT=55
MOON_MAX_AGE_MINUTES=40
MOON_MIN_SCORE=3
MOON_TRIM_TP_PCT=35
MOON_TRIM_2X_PCT_TRIGGER=200
MOON_TRIM_2X_PCT=15
MOON_TRIM_5X_PCT_TRIGGER=500
MOON_TRIM_5X_PCT=15
MOON_TRIM_10X_PCT_TRIGGER=1000
MOON_TRIM_10X_PCT=15
MOON_TRAIL_GIVEBACK_PCT=30
MOON_MAX_HOLD_MINUTES=1440

# Local dashboard (npm run ui) — localhost only by default
UI_HOST=0.0.0.0
UI_PORT=8791

# Paper sizing
PAPER_BUY_ETH=0.01
PAPER_STARTING_EQUITY_ETH=1.0

# Exits
TAKE_PROFIT_PERCENT=65
STOP_LOSS_PERCENT=15
MAX_HOLD_MINUTES=45

# Risk / filters
MIN_INITIAL_LIQUIDITY_ETH=0.25
# Launch (noxa/new V2/V3): stricter floor + settle + sellable roundtrip
MIN_LAUNCH_LIQUIDITY_ETH=0.5
REJECT_NULL_LIQUIDITY=true
REQUIRE_SELLABLE_QUOTE=true
MAX_ROUNDTRIP_TAX_BPS=2500
# Short settle optional; real anti-rug wait is MIN_LAUNCH_AGE_MS (defer queue)
LAUNCH_LIQ_SETTLE_MS=0
LAUNCH_LIQ_DROP_MAX_PCT=35
# Wait after launch, then confirm window — skip if LP yanked (60s–5m rugs)
MIN_LAUNCH_AGE_MS=120000
LAUNCH_LIQ_PROBE_MS=20000
LAUNCH_CONFIRM_MS=90000
# Live: dump if pool WETH collapses soon after entry
EARLY_RUG_WINDOW_MS=600000
EARLY_RUG_LIQ_FRACTION=0.4
MAX_OPEN_POSITIONS=5
DENY_NAME_SUBSTRINGS=scam,honeypot,test
BUY_SCORE_THRESHOLD=40
WATCH_SCORE_THRESHOLD=32

# Live mode only — leave unset in paper mode
PRIVATE_KEY=
MAX_BUY_ETH=0.01
MAX_DAILY_ETH=0.05
MAX_SLIPPAGE_BPS=300
AUTO_SELL=true
# Unattended overnight: auto-buy launches that pass gates (tight caps required)
AUTO_APPROVE_BUYS=false
# Only BUY noxa / new V2 / new V3 (skip trending) — moon-candidate path
LIVE_LAUNCH_ONLY=false
APPROVAL_TTL_SECONDS=300

# --- Example: ~$50 overnight moon-hunt (copy into live .env) ---
# EXECUTION_MODE=live
# DB_PATH=./data/live-overnight.db
# MAX_OPEN_POSITIONS=2
# MAX_MOON_POSITIONS=2
# MAX_BUY_ETH=0.01
# MAX_DAILY_ETH=0.022
# TRENDING_ENABLED=false
# LIVE_LAUNCH_ONLY=true
# AUTO_APPROVE_BUYS=true
# AUTO_SELL=true
# MIN_LAUNCH_LIQUIDITY_ETH=1
# REQUIRE_SELLABLE_QUOTE=true
# LAUNCH_LIQ_SETTLE_MS=0
# MIN_LAUNCH_AGE_MS=190000
# LAUNCH_CONFIRM_MS=90000
# LAUNCH_LIQ_PROBE_MS=20000
# LAUNCH_LIQ_DROP_MAX_PCT=35
# EARLY_RUG_WINDOW_MS=600000
# EARLY_RUG_LIQ_FRACTION=0.4

# Storage
DB_PATH=./data/bot.db

# Rate-limit friendly defaults for the public RPC.
# Prefer Alchemy WSS (set WSS_RPC_URL) — then watchers use subscriptions instead of polling.
POLL_INTERVAL_MS=30000
MARK_INTERVAL_MS=60000
MAX_BLOCKS_PER_POLL=80
ENRICH_DELAY_MS=250
